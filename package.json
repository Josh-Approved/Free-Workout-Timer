{
  "name": "free-workout-timer",
  "version": "1.1.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "expo": "^57.0.14",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-iap": "4.3.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-mail-composer": "~57.0.1",
    "expo-screen-orientation": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.15",
    "live-timer": "file:./modules/live-timer",
    "lucide-react-native": "1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "fast-check": "^3.23.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "reporters": [
      "default",
      "<rootDir>/qa/defect-reporter.cjs"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/qa/quarantine.setup.cjs"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/qa/known-bad/",
      "<rootDir>/.stryker-tmp/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.stryker-tmp/"
    ],
    "testTimeout": 30000
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@xmldom/xmldom": "0.8.15",
    "ws": "^8.20.1",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "form-data": "^4.0.6"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest"
      ]
    }
  }
}
